doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title CRUD - STACK MEN
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  body.bg-light
    nav.navbar.navbar-expand-lg.navbar-dark.bg-primary.py-3.shadow-sm
      .container
        a.navbar-brand.text-warning.fw-bold.fs-3(href='/') Stack Farmacia
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarNavDropdown')
          span.navbar-toggler-icon
        
        #navbarNavDropdown.collapse.navbar-collapse
          ul.navbar-nav.align-items-center.mx-auto
            if user
              li.nav-item
                a.nav-link.active(href='/inicio') <i class="bi bi-house-door"></i> Inicio
              
              if user.role === 'moderador' || user.role === 'administrador'
                // Menú Ventas Desplegable
                li.nav-item.dropdown
                  a.nav-link.dropdown-toggle(href='#', role='button', data-bs-toggle='dropdown') <i class="bi bi-cart"></i> Ventas
                  ul.dropdown-menu.shadow
                    li: a.dropdown-item(href='/ventas/caja') Caja
                
                // Menú Compras Desplegable
                li.nav-item.dropdown
                  a.nav-link.dropdown-toggle(href='#', role='button', data-bs-toggle='dropdown') <i class="bi bi-bag"></i> Compras
                  ul.dropdown-menu.shadow
                    li: a.dropdown-item(href='/compras/proveedores') Proveedores
              
              if user.role === 'administrador'
                // Menú Almacén Desplegable
                li.nav-item.dropdown
                  a.nav-link.dropdown-toggle(href='#', role='button', data-bs-toggle='dropdown') <i class="bi bi-box-seam"></i> Almacen
                  ul.dropdown-menu.shadow
                    li: a.dropdown-item(href='/almacen/productos') Productos

          if user
            .d-flex.align-items-center
              span.badge.bg-light.text-primary.me-3.fs-6
                i.bi.bi-person-circle.me-1
                | #{user.username} (#{user.role})
              a.btn.btn-outline-light.btn-sm(href='/logout') <i class="bi bi-box-arrow-right"></i> Salir
          else
            .d-flex
              a.btn.btn-outline-light.me-2(href='/login') Iniciar Sesión
              a.btn.btn-warning(href='/register') Registrarse

    .container.mt-4.mb-5
      block content

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
