doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title CRUD - STACK MEN
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-primary.py-3
      .container
        a.navbar-brand.text-warning.fw-bold.fs-3(href='/') Stack
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarNavDropdown')
          span.navbar-toggler-icon
        
        #navbarNavDropdown.collapse.navbar-collapse
          ul.navbar-nav.align-items-center.mx-auto
            li.nav-item
              a.nav-link.active(href='/inicio') Inicio
            
            // Menú Ventas Desplegable
            li.nav-item.dropdown
              a.nav-link.dropdown-toggle(href='#', role='button', data-bs-toggle='dropdown') Ventas
              ul.dropdown-menu
                li: a.dropdown-item(href='/ventas/caja') Caja
            
            // Menú Compras Desplegable
            li.nav-item.dropdown
              a.nav-link.dropdown-toggle(href='#', role='button', data-bs-toggle='dropdown') Compras
              ul.dropdown-menu
                li: a.dropdown-item(href='/compras/proveedores') Proveedores
            
            // Menú Almacén Desplegable
            li.nav-item.dropdown
              a.nav-link.dropdown-toggle(href='#', role='button', data-bs-toggle='dropdown') Almacen
              ul.dropdown-menu
                li: a.dropdown-item(href='/almacen/productos') Productos

          // Buscador de la Derecha
          form.d-flex(role='search')
            input.form-control.me-2(type='search', placeholder='Buscar')
            button.btn.btn-outline-light(type='submit') Búsqueda

    .container.mt-4
      block content

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
